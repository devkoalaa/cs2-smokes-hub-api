# API e coletor usam o mesmo banco e chave de criptografia.
DATABASE_URL=postgresql://cs2_smokes:CHANGE_ME@postgres:5432/cs2_smokes
JWT_SECRET=CHANGE_ME
STEAM_API_KEY=
PORT=6969
STEAM_RETURN_URL=https://cs2.devkoala.com/auth/callback
STEAM_REALM=https://cs2.devkoala.com
FRONTEND_URL=https://cs2.devkoala.com
TRACKING_ALLOWED_STEAM_IDS=76561198143147452,76561198284655037,76561198132822021
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_ENCRYPTION_KEY=
# Conta Steam dedicada ao coletor; nunca enviada ao frontend.
# Prefira refresh token. Alternativa: usuário/senha e código Steam Guard inicial.
STEAM_BOT_REFRESH_TOKEN=
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
STEAM_BOT_GUARD_CODE=
STEAM_BOT_EMAIL_CODE=
# Fora do Docker: caminho do Python com demoparser2 instalado.
TRACKING_PYTHON=python3
# Token das rotas /tracking/bot, usadas pelos comandos /cs2 do Clodoaldo (Discord).
# Mesmo valor no .env do Clodoaldo; gere com `openssl rand -hex 32`. Vazio desliga as rotas.
CS2_BOT_TOKEN=
